# ───────────────────────────────────────────────────────────────────
# Environment variables for landonkea-car-scraper
# ───────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ───────────────────────────────────────────────────────────────────

# ── Runtime environment ────────────────────────────────────────────
# "dev" = local testing, no alerts sent
# "staging" = pre-production dry run
# "production" = real alerts go out
# Leave unset for production (GitHub Actions default).
# ENVIRONMENT=dev

# ── Discord alerts ─────────────────────────────────────────────────
# Create a webhook in your Discord server:
#   Server Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=

# Optional: separate webhook for dev/staging test runs
# so local tests don't spam the real channel.
DISCORD_WEBHOOK_URL_DEV=

# Optional: separate webhook for a specific search (e.g. if you
# want car alerts in a different channel than other searches).
# DISCORD_WEBHOOK_URL_CARS=
# DISCORD_WEBHOOK_URL_CARS_DEV=

# ── Email alerts (optional) ────────────────────────────────────────
# Uses Gmail SMTP. You need a Gmail App Password (not your
# normal password). See docs/OPERATIONS.md for setup steps.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
GMAIL_APP_PASSWORD=

# ── Facebook Marketplace (optional) ────────────────────────────────
# Required only if you want to scrape Facebook Marketplace.
# Log into Facebook in Chrome, open DevTools -> Application ->
# Cookies, find the "c_user" cookie value and paste it here.
FACEBOOK_SESSION_COOKIE=
